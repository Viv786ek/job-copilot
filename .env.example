# ============================================================
# VP AI Job Copilot — environment variables
# Copy to apps/api/.env and apps/web/.env.local (see docs/SETUP.md)
# Generate secrets with:  openssl rand -base64 48
# ============================================================

# ---------- API (apps/api/.env) ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Neon: use the pooled URL here and the direct URL below (required for migrations)
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
DIRECT_DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379

# >= 32 chars. Signs API access tokens.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# >= 24 chars. Shared by Next.js (OAuth exchange) and n8n (internal endpoints).
INTERNAL_API_KEY=change-me-internal-key-24-chars-min

# S3-compatible storage (MinIO locally; AWS S3 / Cloudflare R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=job-copilot
S3_ACCESS_KEY_ID=copilot
S3_SECRET_ACCESS_KEY=copilot-secret
S3_FORCE_PATH_STYLE=true

# AI providers: ALL OPTIONAL. With none configured, resume parsing, JD analysis and document
# generation use the built-in deterministic engines. Free options: GEMINI_API_KEY (Google AI
# Studio free tier) or a local model via OPENAI_COMPAT_BASE_URL (Ollama / LM Studio).
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=local,openai,anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenAI-compatible endpoint, e.g. Ollama: http://localhost:11434/v1  (model e.g. llama3.1:8b, qwen2.5:7b)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_CACHE_TTL_SECONDS=604800
FREE_PLAN_MONTHLY_AI_CALLS=50

# Job sources. Keyless sources (Greenhouse, Lever, Ashby, Workable, SmartRecruiters, Recruitee,
# Personio, RemoteOK, We Work Remotely, Remotive, Himalayas, Jobicy, Arbeitnow, Working Nomads)
# always run. These FREE keys add more coverage:
ADZUNA_APP_ID=            # https://developer.adzuna.com  (UK, US, DE, NL, CH, AT, AU, NZ, CA, SG, IN …)
ADZUNA_APP_KEY=
JOOBLE_API_KEY=           # https://jooble.org/api/about   (UAE, Luxembourg, Saudi, Qatar, 60+ countries)
REED_API_KEY=             # https://www.reed.co.uk/developers/jobseeker  (UK)
USAJOBS_API_KEY=          # https://developer.usajobs.gov/apirequest/  (US federal)
USAJOBS_EMAIL=
FIRECRAWL_API_KEY=        # https://firecrawl.dev (free tier) — career pages without a public ATS API
PLAYWRIGHT_ENABLED=false  # true + `npx playwright install chromium` for JS-rendered career pages

# n8n base URL for outbound events, e.g. http://localhost:5678/webhook
N8N_WEBHOOK_BASE_URL=
# Run BullMQ repeatable schedules in this process (true for the worker only)
ENABLE_SCHEDULER=true

# ---------- Web (apps/web/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side URL Next.js uses to reach the API (same as above locally)
API_INTERNAL_URL=http://localhost:4000
AUTH_SECRET=change-me-auth-js-secret
AUTH_URL=http://localhost:3000
# INTERNAL_API_KEY must match the API value above
# INTERNAL_API_KEY=change-me-internal-key-24-chars-min
# Optional OAuth providers (also list them here so the login page shows the buttons)
NEXT_PUBLIC_AUTH_PROVIDERS=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
