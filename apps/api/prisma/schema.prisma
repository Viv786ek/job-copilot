// VP AI Job Copilot — PostgreSQL schema (Neon-compatible)
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================== Identity ==============================

enum Plan {
  FREE
  PRO
  TEAM
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  emailVerified DateTime?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      OAuthAccount[]
  profile       CandidateProfile?
  preferences   JobPreference?
  resumes       Resume[]
  matches       JobMatch[]
  documents     GeneratedDocument[]
  applications  Application[]
  notifications Notification[]
  usage         AiUsage[]
  savedSearches SavedSearch[]
}

model OAuthAccount {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ============================== Candidate ==============================

model CandidateProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  fullName       String?
  headline       String?
  location       String?
  summary        String?
  totalYearsExp  Float    @default(0)
  skills         String[] // canonical skill names
  primaryRoles   String[]
  embedding      Float[] // profile embedding for semantic matching
  resumeHealth   Int      @default(0) // 0..100
  activeResumeId String?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([skills], type: Gin)
}

model JobPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  titles               String[]
  locations            String[]
  remoteOnly           Boolean  @default(false)
  includeInternational Boolean  @default(false)
  needsVisaSponsorship Boolean  @default(false)
  minSalary            Int?
  currency             String   @default("INR")
  minMatchScore        Int      @default(60)
  sources              String[]
  autoGenerateDocs     Boolean  @default(true)
  digestFrequency      String   @default("DAILY") // DAILY | WEEKLY | OFF
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ResumeStatus {
  UPLOADED
  PARSING
  PARSED
  FAILED
}

model Resume {
  id           String              @id @default(cuid())
  userId       String
  fileName     String
  mimeType     String
  storageKey   String
  sizeBytes    Int
  status       ResumeStatus        @default(UPLOADED)
  rawText      String?
  parsed       Json? // ParsedResume
  healthScore  Int?
  healthReport Json?
  errorMessage String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    GeneratedDocument[]

  @@index([userId, createdAt])
}

// ============================== Jobs ==============================

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

model Company {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  website    String?
  logoUrl    String?
  careersUrl String?
  atsType    String? // greenhouse | lever | ashby | custom
  atsBoardId String?
  jobs       Job[]
}

model Job {
  id              String              @id @default(cuid())
  source          String // JobSource
  externalId      String
  url             String
  title           String
  companyId       String?
  companyName     String
  location        String?
  country         String?
  workMode        WorkMode?
  employmentType  String?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  visaSponsorship Boolean?
  description     String
  descriptionHash String
  analysis        Json? // JdAnalysis
  requiredSkills  String[]
  preferredSkills String[]
  minYears        Float?
  embedding       Float[]
  postedAt        DateTime?
  fetchedAt       DateTime            @default(now())
  expiresAt       DateTime?
  isActive        Boolean             @default(true)
  company         Company?            @relation(fields: [companyId], references: [id])
  matches         JobMatch[]
  applications    Application[]
  documents       GeneratedDocument[]

  @@unique([source, externalId])
  @@index([descriptionHash])
  @@index([postedAt])
  @@index([isActive, workMode])
  @@index([requiredSkills], type: Gin)
}

model JobMatch {
  id              String    @id @default(cuid())
  userId          String
  jobId           String
  score           Int
  atsScore        Int
  breakdown       Json
  matchedSkills   String[]
  missingSkills   String[]
  missingKeywords String[]
  recommendations String[]
  dismissed       Boolean   @default(false)
  saved           Boolean   @default(false)
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, score])
}

model SavedSearch {
  id        String    @id @default(cuid())
  userId    String
  query     String
  location  String?
  remote    Boolean   @default(false)
  sources   String[]
  lastRunAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================== Generated docs ==============================

enum DocumentType {
  TAILORED_RESUME
  COVER_LETTER
  LINKEDIN_MESSAGE
  RECRUITER_EMAIL
  FOLLOW_UP_EMAIL
  INTERVIEW_PREP
}

model GeneratedDocument {
  id             String       @id @default(cuid())
  userId         String
  jobId          String?
  resumeId       String?
  applicationId  String?
  type           DocumentType
  version        Int          @default(1)
  content        Json
  atsScoreBefore Int?
  atsScoreAfter  Int?
  guardrailFlags String[] // e.g. removed fabricated skills
  storageKey     String? // rendered DOCX
  model          String?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  resume         Resume?      @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([jobId])
}

// ============================== Tracker ==============================

enum ApplicationStatus {
  DRAFT
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
  GHOSTED
}

model Application {
  id                String              @id @default(cuid())
  userId            String
  jobId             String?
  company           String
  role              String
  source            String
  jobUrl            String?
  status            ApplicationStatus   @default(DRAFT)
  appliedAt         DateTime?
  followUpAt        DateTime?
  recruiterName     String?
  recruiterEmail    String?
  recruiterLinkedin String?
  salaryExpected    String?
  notes             String?
  matchScore        Int?
  responded         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  job               Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  events            ApplicationEvent[]
  interviews        Interview[]
  documents         GeneratedDocument[]

  @@index([userId, status])
  @@index([followUpAt])
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  type          String // STATUS_CHANGE | NOTE | FOLLOW_UP_SENT | EMAIL_RECEIVED
  fromStatus    String?
  toStatus      String?
  message       String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model Interview {
  id            String      @id @default(cuid())
  applicationId String
  round         String // e.g. "Technical 1", "HR"
  scheduledAt   DateTime
  durationMins  Int         @default(60)
  mode          String? // video | phone | onsite
  interviewer   String?
  outcome       String? // PASSED | FAILED | PENDING
  notes         String?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
}

// ============================== Platform ==============================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // NEW_MATCHES | FOLLOW_UP_DUE | RESUME_PARSED | INTERVIEW_REMINDER
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AiUsage {
  id           String   @id @default(cuid())
  userId       String?
  feature      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model SkillAlias {
  alias     String @id
  canonical String
}
